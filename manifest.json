{
    "name": "Canvas Module List",
    "description": "Shows list of modules on the left toolbar of each course on Canvas",
    "version": "0.1",
    "manifest_version": 3,
    "action": {
        "default_popup": "content.html"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["scripts/utility.js", "scripts/index.js"],
            "css": ["styling/overrides.css"]
        }
    ],
    "icons": {
        "16": "assets/icon16.png",
        "32": "assets/icon32.png",
        "48": "assets/icon48.png",
        "128": "assets/icon128.png"
    },
    "web_accessible_resources": [
        {
            "matches": ["<all_urls>"],
            "resources": ["fontawesome/css/all.min.css", "fontawesome/webfonts/*"]
        }
    ]
}